{
  "name": "mystudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @mystudy/frontend",
    "dev:backend": "npm run dev --workspace @mystudy/backend",
    "build": "npm run build --workspace @mystudy/frontend",
    "start": "npm run start --workspace @mystudy/backend"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
